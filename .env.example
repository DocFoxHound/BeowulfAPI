# BeowulfAPI Environment Variables Example
# Copy this file to .env and fill in real values.

# --- Runtime & Server ---
HOST=localhost
PORT=3000
IS_LIVE=false                    # false = test/staging mode, true = production
SESSION_SECRET=change_me         # Secret for express-session

# --- Frontend Origins for CORS ---
TEST_FRONTEND_URL=http://localhost:5173   # Example dev frontend
LIVE_FRONTEND_URL=https://app.example.com # Production frontend full URL
LIVE_FRONTEND_URL_SHORT=https://example.com # Alternate short domain allowed

# --- Discord OAuth ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
TEST_DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
LIVE_DISCORD_CALLBACK_URL=https://api.example.com/auth/discord/callback

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beowulf
DB_USER=beowulf_user
DB_PASSWORD=beowulf_password
DB_SSL=false                     # true if using SSL (e.g., managed cloud Postgres)

# --- API Route Prefixes ---
# Each prefix is mounted in server.js and should start with a leading slash.
API_CLASS_ROUTES=/api/classes
API_RANK_ROUTES=/api/ranks
API_PRESTIGE_ROUTES=/api/prestige-roles
API_USER_ROUTES=/api/users
API_COMPLETED_ENTRY_ROUTES=/api/completed-queue
API_QUEUE_ROUTES=/api/queue
API_BADGES_ROUTES=/api/badges
API_BADGE_REUSABLES_ROUTES=/api/badge-reusables
API_BADGE_ACCOLADES_ROUTES=/api/badge-accolades
API_UEX_ROUTES=/api/uex
API_THREADS_ROUTES=/api/threads
API_MESSAGES_ROUTES=/api/messages
API_BLACKBOX_ROUTES=/api/blackbox
API_HITTRACKER_ROUTES=/api/hit-tracker
API_SHIPLOG_ROUTES=/api/ship-log
API_GAMEVERSION_ROUTES=/api/game-version
API_LESSONSLEARNED_ROUTES=/api/lessons-learned
API_PLAYERSHIP_ROUTES=/api/player-ships
API_WAREHOUSE_ROUTES=/api/warehouse
API_KEY_ROUTES=/api/keys
API_REPORT_KILL=/api/report-kill
API_SCHEDULES=/api/schedules
API_EVENTS_ROUTES=/api/events
API_FLEET_ROUTES=/api/fleets
API_PLAYER_EXPERIENCE_ROUTES=/api/player-experience
API_RECENT_GATHERINGS_ROUTES=/api/recent-gatherings
API_RECENT_FLEETS=/api/recent-fleets
API_LEADERBOARD_SB_ROUTES=/api/leaderboard/sb
API_LEADERBOARD_SB_SUMMARY_ROUTES=/api/leaderboard/sb/summary
API_LEADERBOARD_SB_LOG_ROUTES=/api/leaderboard/sb/logs
API_LEADERBOARD_PIRACY_SUMMARY_ROUTES=/api/leaderboard/piracy/summary
API_LEADERBOARD_BLACKBOX_SUMMARY_ROUTES=/api/leaderboard/blackbox/summary
API_LEADERBOARD_FLEETLOG_SUMMARY_ROUTES=/api/leaderboard/fleetlog/summary
API_BEOWULF_HUNTER_SUMMARY_BY_PATCH_ROUTES=/api/leaderboard/hunter/by-patch
API_VOICE_CHANNEL_SESSIONS_ROUTES=/api/voicechannelsessions
API_EMOJI_ROUTES=/api/emojis
API_PLAYER_STATS_ROUTES=/api/player-stats
API_PROMOTE_PLAYER_ROUTES=/api/promote
API_NOTIFY_AWARD_ROUTES=/api/notify-award
API_GRANT_PRESTIGE_ROUTES=/api/grant-prestige
API_ORG_GOALS_ROUTES=/api/org-goals
API_LEADERBOARD_SB_ORG_ROUTES=/api/leaderboard/sb/orgs
API_LEADERBOARD_SB_ORG_SUMMARY_ROUTES=/api/leaderboard/sb/orgs/summary
API_SCI_API_ROUTES=/api/starcitizen
API_VERIFY_USER_ROUTES=/api/verify-user
API_CALENDAR_AVAILABILITY_ROUTES=/api/calendar-availability
API_KNOWLEDGE_ROUTES=/api/knowledge
API_PLAYER_TRACKER_ROUTES=/api/player-tracker
VOICE_SESSIONS_ENABLE=true            # Set to false to short-circuit voice session routes

